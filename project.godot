; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="云上庭 Courtyards in the Clouds"
config/description="云上庭 — 纪念碑谷风格的推箱解谜游戏"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
boot_splash/bg_color=Color(0.95, 0.9, 0.89, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Game="*res://scripts/autoload/game.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/use_debanding=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=4
environment/defaults/default_clear_color=Color(0.95, 0.9, 0.89, 1)

[shader_globals]

mv_fog_color={
"type": "color",
"value": Color(0.93, 0.88, 0.93, 1)
}
mv_deep_color={
"type": "color",
"value": Color(0.66, 0.6, 0.85, 1)
}
mv_shadow_color={
"type": "color",
"value": Color(0.72, 0.66, 0.86, 1)
}
mv_grad_range={
"type": "vec2",
"value": Vector2(-0.5, -6)
}
mv_fog_range={
"type": "vec2",
"value": Vector2(-3, -9)
}
mv_ao_map={
"type": "sampler2D",
"value": ""
}
mv_ao_rect={
"type": "vec4",
"value": Vector4(0, 0, 1, 1)
}
mv_ao_strength={
"type": "float",
"value": 0.35
}
mv_time_scale={
"type": "float",
"value": 1.0
}
